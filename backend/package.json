{
  "name": "loan-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Loan Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test:bre": "ts-node-dev --transpile-only src/scripts/testBre.ts",
    "test:loan-calc": "ts-node-dev --transpile-only src/scripts/testLoanCalculation.ts",
    "seed": "ts-node-dev --transpile-only src/scripts/seedUsers.ts",
    "test:rbac": "ts-node-dev --transpile-only src/scripts/testRbacMatrix.ts"
  },
  "keywords": [
    "loan",
    "management",
    "backend",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
